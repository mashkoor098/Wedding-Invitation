<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="foreverBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2B070E"/>
      <stop offset="50%" stop-color="#54121F"/>
      <stop offset="100%" stop-color="#190308"/>
    </linearGradient>
    <linearGradient id="goldAcc4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/><stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#foreverBg)"/>
  <!-- Sacred Mandap Arch & Kalash in background -->
  <circle cx="400" cy="270" r="160" fill="#3D0B16" stroke="url(#goldAcc4)" stroke-width="2" stroke-dasharray="4,4"/>
  <!-- Seven sacred flames / diyas -->
  <g transform="translate(400, 290)">
    <ellipse cx="0" cy="40" rx="90" ry="25" fill="#140205" stroke="url(#goldAcc4)" stroke-width="3"/>
    <!-- Sacred Fire -->
    <path d="M-30,30 Q0,-40 30,30 Q0,10 -30,30 Z" fill="#FFA500"/>
    <path d="M-15,30 Q0,-20 15,30 Q0,15 -15,30 Z" fill="#FFD700"/>
  </g>
  <!-- Garland / Varmala Motif -->
  <path d="M 220,160 C 270,240 350,260 400,260 C 450,260 530,240 580,160" stroke="#FF4757" stroke-width="12" stroke-dasharray="14,4" fill="none"/>
  <path d="M 230,170 C 275,245 350,265 400,265 C 450,265 525,245 570,170" stroke="#FFA502" stroke-width="8" stroke-dasharray="10,3" fill="none"/>
  <!-- Label Banner -->
  <rect x="250" y="500" width="300" height="45" rx="4" fill="#190308" stroke="url(#goldAcc4)" stroke-width="1.5"/>
  <text x="400" y="528" font-family="'Cinzel', Georgia, serif" font-size="18" fill="url(#goldAcc4)" font-weight="700" text-anchor="middle" letter-spacing="3">FOREVER BEGINS • 2027</text>
</svg>

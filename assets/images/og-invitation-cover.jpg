<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="100%" height="100%">
  <defs>
    <linearGradient id="ogBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2D080D"/>
      <stop offset="50%" stop-color="#55111B"/>
      <stop offset="100%" stop-color="#190306"/>
    </linearGradient>
    <linearGradient id="ogGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#BF953F"/>
      <stop offset="25%" stop-color="#FCF6BA"/>
      <stop offset="50%" stop-color="#B38728"/>
      <stop offset="75%" stop-color="#FBF5B7"/>
      <stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#ogBg)"/>
  <!-- Royal Borders -->
  <rect x="30" y="30" width="1140" height="570" stroke="url(#ogGold)" stroke-width="4" fill="none"/>
  <rect x="45" y="45" width="1110" height="540" stroke="url(#ogGold)" stroke-width="1.5" stroke-dasharray="8,6" fill="none"/>

  <!-- Monogram Crest -->
  <circle cx="600" cy="180" r="70" stroke="url(#ogGold)" stroke-width="3" fill="#200408"/>
  <text x="600" y="195" font-family="'Cinzel Decorative', serif" font-size="44" font-weight="700" fill="url(#ogGold)" text-anchor="middle">A &amp; A</text>

  <!-- Typography -->
  <text x="600" y="290" font-family="'Montserrat', sans-serif" font-size="16" font-weight="600" fill="#E5C158" text-anchor="middle" letter-spacing="8">ROYAL WEDDING CELEBRATION</text>
  <text x="600" y="370" font-family="'Playfair Display', 'Cinzel', Georgia, serif" font-size="64" font-weight="700" fill="url(#ogGold)" text-anchor="middle" letter-spacing="4">AARAV &amp; ANAYA</text>
  <text x="600" y="440" font-family="'Cormorant Garamond', Georgia, serif" font-size="28" font-style="italic" fill="#FFF3B0" text-anchor="middle">We Cordially Invite You to Celebrate Our Sacred Union</text>
  
  <line x1="450" y1="480" x2="750" y2="480" stroke="url(#ogGold)" stroke-width="2"/>
  <circle cx="600" cy="480" r="6" fill="url(#ogGold)"/>

  <text x="600" y="525" font-family="'Montserrat', sans-serif" font-size="18" font-weight="600" fill="#E5C158" text-anchor="middle" letter-spacing="4">18 JANUARY 2027 • UDAIPUR, RAJASTHAN</text>
</svg>

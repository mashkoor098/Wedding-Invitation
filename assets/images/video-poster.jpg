<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="vidBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#140205"/><stop offset="50%" stop-color="#3B0C15"/><stop offset="100%" stop-color="#0E0103"/>
    </linearGradient>
    <linearGradient id="goldV" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/><stop offset="50%" stop-color="#FFF3B0"/><stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#vidBg)"/>
  <!-- Decorative Palace Arches in background -->
  <path d="M 200,675 L 200,200 C 200,80 1000,80 1000,200 L 1000,675" stroke="url(#goldV)" stroke-width="4" stroke-dasharray="10,6" fill="none" opacity="0.4"/>
  <!-- Central Play Button Circle -->
  <circle cx="600" cy="300" r="60" fill="url(#goldV)" opacity="0.9"/>
  <polygon points="590,275 625,300 590,325" fill="#250409"/>
  <!-- Video Title Text -->
  <text x="600" y="440" font-family="'Cinzel Decorative', 'Playfair Display', serif" font-size="34" fill="url(#goldV)" font-weight="700" text-anchor="middle" letter-spacing="4">A SPECIAL VIDEO INVITATION</text>
  <text x="600" y="480" font-family="'Montserrat', sans-serif" font-size="16" fill="#FFE599" text-anchor="middle" letter-spacing="3">AARAV &amp; ANAYA • THE ROYAL WEDDING</text>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="sunsetGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4B1238"/>
      <stop offset="40%" stop-color="#9C3048"/>
      <stop offset="70%" stop-color="#D97736"/>
      <stop offset="100%" stop-color="#E8A856"/>
    </linearGradient>
    <linearGradient id="lakeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#A24A2F"/>
      <stop offset="40%" stop-color="#542438"/>
      <stop offset="100%" stop-color="#1E0E1C"/>
    </linearGradient>
    <linearGradient id="goldAcc3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/><stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <!-- Sunset Sky -->
  <rect width="800" height="360" fill="url(#sunsetGrad)"/>
  <!-- Sun Setting -->
  <circle cx="400" cy="300" r="70" fill="#FFEAA7" opacity="0.9"/>
  <!-- Jagmandir Palace Silhouette on Horizon -->
  <path d="M 150,360 L 150,310 L 180,310 L 180,270 L 220,270 L 220,310 L 270,310 L 270,250 C 270,230 300,230 300,250 L 300,310 L 500,310 C 500,240 540,240 540,310 L 620,310 L 650,360 Z" fill="#240716"/>
  <!-- Lake Pichola Water -->
  <rect y="360" width="800" height="240" fill="url(#lakeGrad)"/>
  <!-- Water Shimmer Lines -->
  <ellipse cx="400" cy="390" rx="140" ry="6" fill="#F39C12" opacity="0.6"/>
  <ellipse cx="400" cy="420" rx="90" ry="4" fill="#F39C12" opacity="0.5"/>
  <ellipse cx="400" cy="450" rx="50" ry="3" fill="#F39C12" opacity="0.4"/>
  <!-- Proposal Silhouette on Boat -->
  <g transform="translate(320, 370)">
    <path d="M 0,60 C 30,85 130,85 160,60 L 140,90 C 100,105 60,105 20,90 Z" fill="#15030B"/>
    <!-- Lantern on boat -->
    <circle cx="25" cy="45" r="8" fill="#FFD700" opacity="0.8"/>
    <!-- Kneeling Proposer & Bride -->
    <circle cx="65" cy="40" r="8" fill="#15030B"/>
    <path d="M 55,48 L 75,48 L 85,80 L 50,80 Z" fill="#15030B"/>
    <circle cx="105" cy="35" r="8" fill="#15030B"/>
    <path d="M 95,43 L 115,43 L 120,80 L 90,80 Z" fill="#15030B"/>
  </g>
  <!-- Label Banner -->
  <rect x="250" y="520" width="300" height="45" rx="4" fill="#1A0714" stroke="url(#goldAcc3)" stroke-width="1.5"/>
  <text x="400" y="548" font-family="'Cinzel', Georgia, serif" font-size="18" fill="url(#goldAcc3)" font-weight="700" text-anchor="middle" letter-spacing="3">UDAIPUR PROPOSAL • 2024</text>
</svg>

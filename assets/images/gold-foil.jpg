<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <radialGradient id="foilGlow1" cx="30%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#FFFAD0"/>
      <stop offset="25%" stop-color="#E5C158"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="75%" stop-color="#996515"/>
      <stop offset="100%" stop-color="#5E3E0C"/>
    </radialGradient>
    <radialGradient id="foilGlow2" cx="75%" cy="75%" r="60%">
      <stop offset="0%" stop-color="#FFFDF0" stop-opacity="0.8"/>
      <stop offset="40%" stop-color="#E5C158" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#734B0B" stop-opacity="0.9"/>
    </radialGradient>
    <pattern id="foilNoise" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M0 15 L15 0 L30 15 L15 30 Z" fill="none" stroke="#FFF" stroke-width="0.7" opacity="0.2"/>
      <circle cx="15" cy="15" r="1.5" fill="#FFEAA7" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="600" height="400" fill="url(#foilGlow1)"/>
  <rect width="600" height="400" fill="url(#foilGlow2)"/>
  <rect width="600" height="400" fill="url(#foilNoise)"/>
  <!-- Gold Glitter Shimmer highlights -->
  <circle cx="180" cy="120" r="3" fill="#FFFFFF" opacity="0.9"/>
  <circle cx="420" cy="90" r="2.5" fill="#FFFFFF" opacity="0.8"/>
  <circle cx="310" cy="240" r="3.5" fill="#FFFFFF" opacity="0.9"/>
  <circle cx="500" cy="300" r="2" fill="#FFFFFF" opacity="0.85"/>
  <circle cx="100" cy="320" r="3" fill="#FFFFFF" opacity="0.75"/>
</svg>

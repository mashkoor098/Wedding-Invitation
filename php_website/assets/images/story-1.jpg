<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1A0A10"/>
      <stop offset="40%" stop-color="#3A1520"/>
      <stop offset="100%" stop-color="#551E28"/>
    </linearGradient>
    <linearGradient id="goldAcc" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/><stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#skyGrad1)"/>
  <!-- Cafe Heritage Window Architecture -->
  <path d="M 200,600 L 200,250 C 200,100 600,100 600,250 L 600,600" stroke="url(#goldAcc)" stroke-width="4" fill="#240A12"/>
  <!-- Two Steaming Coffee Cups -->
  <ellipse cx="340" cy="380" rx="35" ry="15" fill="#3D180A"/>
  <path d="M 310,380 C 310,430 370,430 370,380 Z" fill="#D4AF37"/>
  <ellipse cx="460" cy="380" rx="35" ry="15" fill="#3D180A"/>
  <path d="M 430,380 C 430,430 490,430 490,380 Z" fill="#D4AF37"/>
  <!-- Steam Curves -->
  <path d="M 340,360 C 330,320 350,300 335,260" stroke="#FFF3B0" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 460,360 C 450,320 470,300 455,260" stroke="#FFF3B0" stroke-width="2" fill="none" opacity="0.6"/>
  <!-- Rain Droplets on window -->
  <line x1="150" y1="180" x2="140" y2="240" stroke="#FFF3B0" stroke-width="1.5" opacity="0.3"/>
  <line x1="650" y1="160" x2="640" y2="220" stroke="#FFF3B0" stroke-width="1.5" opacity="0.3"/>
  <!-- Label Banner -->
  <rect x="250" y="490" width="300" height="50" rx="4" fill="#150205" stroke="url(#goldAcc)" stroke-width="1.5"/>
  <text x="400" y="522" font-family="'Cinzel', Georgia, serif" font-size="18" fill="url(#goldAcc)" font-weight="700" text-anchor="middle" letter-spacing="3">MUMBAI MONSOONS • 2019</text>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0B1A24"/>
      <stop offset="60%" stop-color="#1B384A"/>
      <stop offset="100%" stop-color="#3A637B"/>
    </linearGradient>
    <linearGradient id="goldAcc2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/><stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#skyGrad2)"/>
  <!-- Mountain Peaks -->
  <polygon points="0,600 200,200 450,600" fill="#13232E"/>
  <polygon points="200,200 260,290 200,320 140,290" fill="#E8F4F8"/>
  <polygon points="250,600 520,150 800,600" fill="#0E1A22"/>
  <polygon points="520,150 600,270 520,300 440,270" fill="#E8F4F8"/>
  <!-- Starlit Sky -->
  <circle cx="200" cy="80" r="1.5" fill="#FFF"/>
  <circle cx="350" cy="60" r="2" fill="#FFF"/>
  <circle cx="480" cy="90" r="1.5" fill="#FFF"/>
  <circle cx="650" cy="70" r="2.5" fill="#FFF"/>
  <circle cx="720" cy="110" r="1.5" fill="#FFF"/>
  <!-- Campfire & Warm Glow -->
  <circle cx="400" cy="500" r="60" fill="#FF8C00" opacity="0.4"/>
  <polygon points="380,510 400,450 420,510" fill="#FFD700"/>
  <polygon points="390,510 400,470 410,510" fill="#FF4500"/>
  <!-- Label Banner -->
  <rect x="250" y="530" width="300" height="45" rx="4" fill="#0B1A24" stroke="url(#goldAcc2)" stroke-width="1.5"/>
  <text x="400" y="558" font-family="'Cinzel', Georgia, serif" font-size="18" fill="url(#goldAcc2)" font-weight="700" text-anchor="middle" letter-spacing="3">HIMACHAL PEAKS • 2021</text>
</svg>
